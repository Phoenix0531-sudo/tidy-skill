# tidy-skill — default ignore rules
#
# Agent-generated artifacts should never be committed to Git.
# These directories hold working state from AI coding agents.
# If a report in .agent_reports/ gains long-term value, move it
# to docs/ and track it explicitly.

# Artifact directories managed by 洁癖.skill
# Keep directory markers tracked so a fresh clone stays score-reproducible.
.agent_tmp/*
!.agent_tmp/.gitkeep
.agent_reports/*
!.agent_reports/.gitkeep
# Allow tracked docs under agent_tmp only if explicitly force-added; default ignore all.

# Editor / OS artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs from cleanup & audit actions
*.log

# Node / Python dependency dirs
node_modules/
.venv/
venv/
__pycache__/

# Build / packaging / test caches
dist/
build/
target/
bin/
obj/
.next/
.nuxt/
packages/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/

# Keep the packaged skill resources tracked under skills/tidy-skill/.
tasks/

# tidy-skill — default ignore rules
#
# Agent-generated artifacts should never be committed to Git.
# These directories hold working state from AI coding agents.
# If a report in .agent_reports/ gains long-term value, move it
# to docs/ and track it explicitly.

# Artifact directories managed by Tidy Skill
.agent_tmp/
.agent_reports/

# Editor / OS artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs from cleanup & audit actions
*.log

# Node / Python dependency dirs
node_modules/
.venv/
venv/
__pycache__/

# Build output
dist/
build/
target/
bin/
obj/
.next/
.nuxt/
packages/

# Keep templates/, scripts/, examples/, references/ tracked
# (They are not excluded by any of the above rules.)
